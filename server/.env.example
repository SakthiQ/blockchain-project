# ============================================================
# ChainJudge - Backend Server Environment Variables Template
# ============================================================

# Environment & Server Port
PORT=5000
NODE_ENV=production

# Supabase Database Configuration
# Get these credentials from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Alternative MongoDB URI (Optional)
MONGO_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/chainjudge?retryWrites=true&w=majority"

# Upstash Redis / Redis URL (for Vercel Serverless rate limiting & caching)
REDIS_URL="redis://default:password@your-redis-instance.upstash.io:6379"

# CORS Origin Whitelist (comma-separated origins or * for open access)
CORS_ORIGIN="https://chainjudge.vercel.app,http://localhost:5173"

# JWT Secret
JWT_SECRET="super-secret-jwt-key-change-in-production"
