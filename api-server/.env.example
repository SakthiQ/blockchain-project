# ============================================================
# ChainJudge API Server — Environment Variables
# Set these in Vercel → Settings → Environment Variables
# ============================================================

# Supabase — the only datastore. Both are required; without them
# every /api route returns 503 and /api/health reports "degraded".
# Supabase → Project Settings → API
SUPABASE_URL="https://XXXXXXXXXXXX.supabase.co"
SUPABASE_ANON_KEY=""

# Secret used to sign session tokens. Required in production.
JWT_SECRET=""

# Comma-separated list of allowed browser origins.
# Set to your deployed URL after the first deploy, e.g. https://chainjudge.vercel.app
# Leave unset to allow all origins (local development only).
CORS_ORIGIN=""

# Local API server port (ignored on Vercel).
PORT=5000
