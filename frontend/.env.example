# ============================================================
# ChainJudge - Frontend Environment Variables Template
# ============================================================

# API Base URL (Leave as /api for Vercel relative pathing or set custom domain)
VITE_API_BASE_URL="/api"

# Deployed Smart Contract Address (Sepolia / Base Sepolia / Localhost)
VITE_CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"

# EVM Chain ID (31337 for Hardhat Local, 11155111 for Sepolia, 84532 for Base Sepolia)
VITE_CHAIN_ID="11155111"

# Public RPC URL for read-only contract calls (no wallet needed)
# Sepolia: https://rpc.sepolia.org  |  Base Sepolia: https://sepolia.base.org
VITE_RPC_URL="https://rpc.sepolia.org"

# Local Hardhat RPC (only used in local dev / demo mode)
VITE_LOCAL_RPC_URL="http://127.0.0.1:8545"
