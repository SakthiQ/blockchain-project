# ============================================================
# ChainJudge Frontend — Build-Time Environment Variables
# ============================================================
# WARNING: every VITE_ value is compiled into the public JS bundle
# and is readable by anyone. Never put a secret here.

# Path the frontend calls for API requests. Leave as /api — the same
# Vercel deployment serves both the app and the API.
VITE_API_BASE_URL="/api"

# Read-only RPC endpoint used when no wallet is connected.
VITE_RPC_URL="https://rpc.sepolia.org"

# Local Hardhat node, used only by `npm run dev`.
VITE_LOCAL_RPC_URL="http://127.0.0.1:8545"

# NOTE: contract addresses are NOT configured here. They are read from
# frontend/src/contracts/contract-address.json, which `npm run deploy:sepolia`
# regenerates — commit that file after deploying.
