{
  "name": "blockchain-hackathon-judging",
  "version": "1.0.0",
  "description": "Blockchain-Based Hackathon Judging Platform \u2014 Undergraduate Introductory Blockchain Project",
  "private": true,
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "check:boot": "node scripts/check-serverless-boot.js",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:base-sepolia": "hardhat run scripts/deploy.js --network baseSepolia",
    "seed:local": "hardhat run scripts/seed.js --network localhost",
    "seed:users": "node db-schemas/seeds/seedUsers.js",
    "start": "node api-server/server.js",
    "server": "node api-server/server.js",
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "vercel-build": "cd frontend && npm install && npm run build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  }
}
